# Primary LLM: local first tries Ollama, then hosted (or reverse if ASTRO_PRIMARY=hosted)
ASTRO_PRIMARY=local

OLLAMA_BASE_URL=http://127.0.0.1:12434
OLLAMA_MODEL=llama3.2

# OpenAI-compatible API (OpenAI, Groq, etc.)
OPENAI_API_KEY=''

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional illustrative images (off by default)
ASTRO_ENABLE_IMAGE_GEN=false
